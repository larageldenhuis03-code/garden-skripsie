{
  "name": "silly-goose-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "data:sync": "node data/scripts/sync_dataset.mjs",
    "predev": "npm run data:sync",
    "dev": "vinext dev",
    "prebuild": "npm run data:sync",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run test:unit && npm run test:render",
    "test:unit": "node --experimental-strip-types --test tests/planning-engine.test.ts tests/stage1.test.ts tests/engine.test.ts tests/data-foundation.test.ts tests/sourcing.test.ts tests/sourcing-split.test.ts",
    "test:render": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:batch": "node --experimental-strip-types scripts/batch-test/run-batch.ts",
    "study:nmin": "node --experimental-strip-types scripts/nmin-study.ts",
    "study:bands": "node --experimental-strip-types scripts/band_eval.ts",
    "chapter5": "node --experimental-strip-types scripts/chapter5/run-all.ts",
    "study:pool": "node --experimental-strip-types scripts/pool_study.ts",
    "study:sensitivity": "node --experimental-strip-types scripts/sensitivity.ts",
    "study:tiers": "node --experimental-strip-types scripts/tier_reach.ts",
    "study:capacity": "node --experimental-strip-types scripts/capacity_anneal.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.59.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "type": "module"
}
